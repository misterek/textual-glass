/* textual-glass showcase. Plain Textual CSS: nothing here knows about glass.
   Breakpoints (on the screen): -narrow / -wide at 120 columns, -short / -tall at 36 rows. */

/* -- top bar ---------------------------------------------------------------------------- */

#bar {
    height: 1;
    background: $panel;
}

#brand {
    width: auto;
    padding: 0 1;
}

#summary {
    width: 1fr;
    padding: 0 1;
    text-align: right;
}

#views, View {
    height: 1fr;
}

/* -- 1: stock widgets ------------------------------------------------------------------- */

DataTable, OptionList, RichLog, #rollout, #runbook {
    border: round $primary;
    border-title-color: $foreground;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    background: $surface;
}

#stock-left {
    width: 3fr;
}

#stock-right {
    width: 2fr;
}

#services {
    height: 1fr;
}

#incidents {
    height: auto;
    max-height: 45%;
    border: round $error;
}

#activity {
    display: none;
    height: 1fr;
}

Screen.-tall #activity {
    display: block;
}

#deploys {
    height: auto;
    padding: 0;
}

#rollout {
    height: auto;
    padding: 0 1;
}

#rollout ProgressBar {
    width: 100%;
    margin-bottom: 0;
}

#rollout Bar {
    width: 1fr;
}

#bar-checkout Bar > .bar--bar {
    color: $warning;
}

#runbook {
    height: 1fr;
    padding: 0 1;
}

#runbook Markdown, #service-notes Markdown {
    margin: 0;
    padding: 0;
}

#runbook MarkdownH2, #service-notes MarkdownH2 {
    margin: 0 0 1 0;
}

/* -- 2: pixel widgets ------------------------------------------------------------------- */

#px-top {
    height: 9;
}

Screen.-tall #px-top {
    height: 11;
}

#px-top GlassPanel {
    width: 1fr;
    height: 1fr;
}

#px-top Horizontal {
    height: 1fr;
}

.wide-only {
    display: none;
}

Screen.-wide .wide-only {
    display: block;
}

#px-mid {
    height: 1fr;
}

#services-panel {
    width: 3fr;
    height: 1fr;
}

#detail {
    width: 2fr;
    height: 1fr;
}

#detail-top {
    height: 4;
}

Screen.-tall #detail-top {
    height: 8;
}

#beacon {
    width: 8;
    height: 4;
    margin-right: 1;
}

Screen.-tall #beacon {
    width: 14;
    height: 7;
    margin-right: 2;
}

#card {
    width: 1fr;
}

#detail-chart {
    height: 1fr;
}

#px-bottom {
    height: 8;
}

Screen.-tall #px-bottom {
    height: 10;
}

/* -- popups ----------------------------------------------------------------------------- */

ShipScreen, ServiceScreen {
    align: center middle;
}

#ship-dialog {
    width: 76;
    height: 17;
    padding: 1 2;
    align: left middle;
    border: round $warning;
    background: $panel;
}

ShipScreen.-tall #ship-dialog {
    width: 92;
    height: 24;
}

#art {
    width: 26;
    height: 13;
    margin-right: 2;
}

ShipScreen.-tall #art {
    width: 40;
    height: 20;
    margin-right: 3;
}

#ship-text {
    width: 1fr;
    height: auto;
}

#ship-title {
    margin-bottom: 1;
}

#ship-command {
    margin: 1 0;
    padding: 0 1;
    background: $surface;
    color: $text-success;
}

#ship-keys {
    margin-top: 1;
}

#service-dialog {
    width: 86%;
    max-width: 110;
    height: 80%;
    padding: 0 1;
    border: round $primary;
    background: $panel;
}

#service-title {
    margin-top: 1;
}

#service-lower {
    height: 1fr;
    margin-top: 1;
}

#service-notes {
    width: 1fr;
    padding: 0 1;
    border: round $secondary;
    border-title-color: $foreground;
}

#service-deploys {
    width: auto;
    max-width: 64%;
    border: round $secondary;
}
